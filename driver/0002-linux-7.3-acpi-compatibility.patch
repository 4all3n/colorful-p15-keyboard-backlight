+static inline acpi_handle clevo_acpi_get_handle(void)
+{
+	if (!active_driver_data)
+		return NULL;
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
+	return acpi_device_handle(active_driver_data->adev);
+#else
+	return active_driver_data->handle;
+#endif
